{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "resolveJsonModule": true
  },
  "include": ["server.ts", "src/lib/mongoose.ts", "src/lib/email.ts", "src/lib/drip-cron.ts", "src/models/**/*.ts"],
  "exclude": ["node_modules"]
}
